# =============================================================================
# PREFERRED: put secrets in one home file (chmod 600):
#   ~/.config/x-api/credentials.env
#
# Optional project override (gitignored): docs/ads/x_ads.env
# CLI loads HOME first, then this file.
# =============================================================================
#
# OAuth 2.0 already there (X_CLIENT_ID, X_ACCESS_TOKEN, …) = tweets/API v2 only.
# Ads *campaign* API needs OAuth 1.0a — APPEND these lines to the same file:
#
#   X_ADS_CONSUMER_KEY=...          # developer.x.com → App → OAuth 1.0 → Consumer Key
#   X_ADS_CONSUMER_SECRET=...       # Consumer Secret
#   X_ADS_ACCESS_TOKEN=...          # OAuth 1.0 Access Token (@koshak0006)
#   X_ADS_ACCESS_TOKEN_SECRET=...   # Access Token Secret
#   X_ADS_ACCOUNT_ID=...            # from: python3 x_ads_cli.py whoami
#
# Ads API access must be approved for App ID 33270394 (form submitted).
# Pixel/CAPI token is unrelated — do not use it here.

X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN_SECRET=
X_ADS_ACCOUNT_ID=

X_ADS_TWEET_ID=
X_ADS_DAILY_BUDGET_MICROS=5000000
X_ADS_CAMPAIGN_NAME=tidex6-ceremony-compliant
